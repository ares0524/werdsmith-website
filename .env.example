# Server-only — the Werdsmith backend that serves the public /portfolio/* endpoints.
# Production: https://api.werdsmith.app — use http://localhost:4000 when running the backend locally.
API_BASE_URL=https://api.werdsmith.app

# Canonical origin of the deployed site — used for metadata, sitemap.xml, and robots.txt.
# Must match the host actually served: the apex domain 308-redirects to www.
NEXT_PUBLIC_SITE_URL=https://www.werdsmith.app

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave unset to disable analytics entirely.
NEXT_PUBLIC_GA_ID=
